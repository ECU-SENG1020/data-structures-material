def my_function(arr: list, target):
	lower_bound = 0
	upper_bound = len(arr) - 1
	while lower_bound <= upper_bound:
		inspected = (lower_bound + upper_bound) // 2
		if arr[inspected] == target:
			return inspected
		elif arr[inspected] < target:
			lower_bound = inspected + 1
		else:
			upper_bound = inspected - 1
	return -1
	

def my_function(arr, target):
	for i in arr:
		if arr[i] == target:
			return i
	return -1
	

